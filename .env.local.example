# Copiar este archivo como .env.local y completar los valores

# Supabase (obtener desde https://supabase.com/dashboard > Project > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Contraseña de acceso a la app (define tu propia contraseña)
ADMIN_PASSWORD=tu_contrasena_aqui

# Secreto para firmar cookies de sesión (cadena aleatoria larga)
SESSION_SECRET=un_secreto_muy_largo_y_aleatorio_aqui_min_32_chars

# Anthropic API Key (para informes y ayuda de redacción con IA)
ANTHROPIC_API_KEY=sk-ant-...
